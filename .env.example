DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=acmer_stats
PORT=3000

# 64 hex characters generated with crypto.randomBytes(32)
ACCOUNT_SECRET_KEY=

# QOJ only: blank=direct, system=Windows proxy, or explicit http(s)://host:port
QOJ_PROXY_URL=

# Optional Windows native curl transport; blank uses Node fetch
QOJ_HTTP_TRANSPORT=
